{
  "name": "drop-and-flap",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --configLoader runner",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build --configLoader runner",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --configLoader runner",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node node_modules/vitest/vitest.mjs run src --configLoader runner",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "assets": "node scripts/prepare-assets.mjs",
    "check": "npm run lint && npm run build && npm test",
    "test:form": "node node_modules/@playwright/test/cli.js test --config=playwright.form.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@fontsource/press-start-2p": "^5.2.5",
    "@fontsource/vt323": "^5.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
